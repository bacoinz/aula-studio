<UserControl x:Class="AulaStudio.Controls.ImageComposer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:AulaStudio.Localization"
             xmlns:c="clr-namespace:AulaStudio.Controls">
    <StackPanel>
        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Composer_Text}" Margin="0,0,0,6" />
        <ui:TextBox x:Name="MessageText" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"
                    PlaceholderText="{l:Tr Composer_TextPlaceholder}" TextChanged="OnChanged" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Composer_Font}" />
            <ComboBox x:Name="FontBox" Grid.Column="1" SelectionChanged="OnChanged" IsTextSearchEnabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Source}" FontFamily="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Composer_Size}" />
            <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="10" Maximum="110" Value="36" ValueChanged="OnChanged" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=SizeSlider, StringFormat=0}" />
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Composer_Style}" />
            <WrapPanel Grid.Column="1">
                <ToggleButton x:Name="BoldToggle" Content="B" FontWeight="Bold" Width="36" Margin="0,0,6,0" Click="OnChanged" />
                <ToggleButton x:Name="ShadowToggle" Content="{l:Tr Composer_Shadow}" Margin="0,0,16,0" Click="OnChanged" IsChecked="True" />
                <RadioButton x:Name="AlignLeft" GroupName="Align" Content="{l:Tr Composer_Left}" Margin="0,0,10,0" Checked="OnChanged" />
                <RadioButton x:Name="AlignCenter" GroupName="Align" Content="{l:Tr Composer_Center}" Margin="0,0,10,0" IsChecked="True" Checked="OnChanged" />
                <RadioButton x:Name="AlignRight" GroupName="Align" Content="{l:Tr Composer_Right}" Checked="OnChanged" />
            </WrapPanel>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Composer_Position}" />
            <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" ValueChanged="OnChanged" VerticalAlignment="Center" />
        </Grid>

        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Composer_TextColor}" Margin="0,4,0,6" />
        <c:ColorSwatches x:Name="TextColor" />

        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Composer_Background}" Margin="0,8,0,6" />
        <c:ColorSwatches x:Name="BackColor" />
        <WrapPanel Margin="0,4,0,0">
            <ui:Button Content="{l:Tr Composer_PickImage}" Click="OnPickImage" Margin="0,0,8,6">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Image24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="ClearImage" Content="{l:Tr Composer_ClearImage}" Click="OnClearImage" Margin="0,0,16,6" Visibility="Collapsed" />
            <StackPanel x:Name="DimPanel" Orientation="Horizontal" Visibility="Collapsed">
                <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Composer_Dim}" Margin="0,0,8,0" />
                <Slider x:Name="DimSlider" Width="140" Minimum="0" Maximum="0.8" Value="0.3" ValueChanged="OnChanged" VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
