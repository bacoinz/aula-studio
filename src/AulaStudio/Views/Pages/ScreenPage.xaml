<Page x:Class="AulaStudio.Views.Pages.ScreenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:AulaStudio.Localization"
      xmlns:c="clr-namespace:AulaStudio.Controls"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock Grid.ColumnSpan="3" FontTypography="Title" Text="{l:Tr Screen_Title}" Margin="0,0,0,20" />

            <!-- Left: source -->
            <Grid Grid.Row="1" Grid.Column="0">
                <!-- Empty state -->
                <Border x:Name="DropZone" MinHeight="330" CornerRadius="8" BorderThickness="2"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="40" Margin="0,0,0,12" />
                        <ui:TextBlock FontTypography="Subtitle" HorizontalAlignment="Center" Text="{l:Tr Screen_Drop}" />
                        <ui:TextBlock HorizontalAlignment="Center" Margin="0,6,0,16"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Screen_DropHint}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Primary" Content="{l:Tr Screen_Browse}" Click="OnBrowse" Margin="0,0,8,0">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{l:Tr Screen_Compose}" Click="OnCompose">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="TextEditStyle24" /></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <ui:TextBlock x:Name="FfmpegMissing" Visibility="Collapsed" Margin="0,16,0,0" MaxWidth="360" TextWrapping="Wrap"
                                      TextAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                      Text="{l:Tr Screen_NoFfmpeg}" />
                    </StackPanel>
                </Border>

                <!-- Image composer -->
                <StackPanel x:Name="ComposerPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Composer_Back}" Click="OnComposerBack">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:TextBlock FontTypography="BodyStrong" VerticalAlignment="Center" Text="{l:Tr Composer_Title}" />
                    </DockPanel>
                    <ui:Card Padding="20,16">
                        <c:ImageComposer x:Name="Composer" />
                    </ui:Card>
                </StackPanel>

                <!-- Editor -->
                <StackPanel x:Name="Editor" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="{l:Tr Screen_Replace}" Click="OnBrowse">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                        </ui:Button>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock x:Name="FileName" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock x:Name="FileInfo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <Border CornerRadius="8" Background="#FF101010" Height="300" ClipToBounds="True">
                        <c:CropEditor x:Name="Crop" Margin="8" />
                    </Border>
                    <ui:TextBlock x:Name="CropHint" Margin="0,6,0,12" FontSize="12"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Screen_CropHint}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeFill" GroupName="Mode" IsChecked="True" Content="{l:Tr Screen_ModeFill}" Checked="OnOptionChanged" Margin="0,0,12,0" />
                            <RadioButton x:Name="ModeFit" GroupName="Mode" Content="{l:Tr Screen_ModeFit}" Checked="OnOptionChanged" />
                        </StackPanel>
                        <ui:TextBlock x:Name="ZoomLabel" Grid.Column="2" VerticalAlignment="Center" Text="{l:Tr Screen_Zoom}" />
                        <Slider x:Name="ZoomSlider" Grid.Column="4" Minimum="1" Maximum="4" Value="1" VerticalAlignment="Center"
                                ValueChanged="OnZoomChanged" />
                    </Grid>

                    <StackPanel x:Name="TimePanel">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Screen_Start}" />
                            <Slider x:Name="StartSlider" Grid.Column="1" VerticalAlignment="Center" ValueChanged="OnRangeChanged" />
                            <ui:TextBlock x:Name="StartText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Screen_End}" />
                            <Slider x:Name="EndSlider" Grid.Column="1" VerticalAlignment="Center" ValueChanged="OnRangeChanged" />
                            <ui:TextBlock x:Name="EndText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Screen_Fps}" TextWrapping="Wrap" />
                            <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="1" Maximum="30" Value="10" IsEnabled="False"
                                    VerticalAlignment="Center" ValueChanged="OnOptionChanged" />
                            <CheckBox x:Name="FpsAuto" Grid.Column="2" Margin="12,0,0,0" IsChecked="True"
                                      Content="{l:Tr Screen_FpsAuto}" Click="OnFpsAutoClicked" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Right: preview and send -->
            <StackPanel Grid.Row="1" Grid.Column="2" Width="406">
                <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Screen_Preview}" Margin="0,0,0,8" />
                <Border CornerRadius="10" Background="#FF1C1C1C" Padding="10" HorizontalAlignment="Left"
                        BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Grid Width="384" Height="216">
                        <Rectangle Fill="Black" />
                        <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <ui:ProgressRing x:Name="Converting" IsIndeterminate="True" Visibility="Collapsed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ui:TextBlock x:Name="FrameCount" Margin="0,8,0,0" FontTypography="BodyStrong" />
                <ui:TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Screen_LimitNote}" />
                <ui:TextBlock x:Name="Estimate" Margin="0,2,0,16" FontSize="12" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button x:Name="SendButton" Appearance="Primary" HorizontalAlignment="Stretch" Height="40"
                           Content="{l:Tr Screen_Send}" IsEnabled="False" Click="OnSend">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" /></ui:Button.Icon>
                </ui:Button>
                <ProgressBar x:Name="SendProgress" Margin="0,8,0,0" Height="4" Visibility="Collapsed" Maximum="1" />
                <ui:TextBlock x:Name="SendStatus" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Recent uploads -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,28,0,0">
                <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Screen_Recent}" Margin="0,0,0,10" />
                <ui:TextBlock x:Name="RecentEmpty" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Screen_RecentEmpty}" />
                <ItemsControl x:Name="Recent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,10,10" Padding="8" Width="200">
                                <StackPanel>
                                    <Image Source="{Binding Thumbnail}" Width="184" Height="103" Stretch="Fill" />
                                    <ui:TextBlock Margin="0,6,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ui:Button Content="{l:Tr Screen_Load}" Tag="{Binding}" Click="OnUseRecent" Margin="0,0,6,0" />
                                        <ui:Button Appearance="Transparent" Tag="{Binding}" Click="OnDeleteRecent"
                                                   ToolTip="{l:Tr Screen_Delete}">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
