<Page x:Class="AulaStudio.Views.Pages.LightingPage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:AulaStudio.Localization"
      xmlns:c="clr-namespace:AulaStudio.Controls"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!-- A keycap for the shortcut guide. -->
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <!-- Fluent-style tab headers: plain text, accent underline on the selected tab. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="14,8" Margin="0,0,4,0" Cursor="Hand">
                            <Grid>
                                <ContentPresenter x:Name="Header" ContentSource="Header" HorizontalAlignment="Center" Margin="0,0,0,6"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="Underline" Height="3" Width="20" CornerRadius="1.5" VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Light_Title}" Margin="0,0,0,12" />

            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
                <!-- Effects -->
                <TabItem Header="{l:Tr Light_TabEffects}">
                    <StackPanel Margin="0,16,0,0">
                        <ListBox x:Name="Effects" SelectionChanged="OnEffectChanged" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="118" Margin="4,8">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="26" HorizontalAlignment="Center" />
                                        <ui:TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ui:Card Margin="0,16,0,0" Padding="20,16">
                            <StackPanel>
                                <ui:TextBlock x:Name="NoControls" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{l:Tr Light_NoControls}" />

                                <StackPanel x:Name="ColorRow" Margin="0,0,0,12">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Light_Color}" Margin="0,0,0,8" />
                                    <c:ColorSwatches x:Name="EffectColor" />
                                    <StackPanel x:Name="RainbowRow" Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:ToggleSwitch x:Name="Rainbow" Click="OnEffectOptionChanged" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{l:Tr Light_Rainbow}" />
                                            <ui:TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Light_RainbowDesc}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Grid x:Name="BrightnessRow" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Light_Brightness}" />
                                    <Slider x:Name="Brightness" Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="OnEffectOptionChanged" />
                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                  Text="{Binding Value, ElementName=Brightness}" />
                                </Grid>

                                <Grid x:Name="SpeedRow" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Light_Speed}" />
                                    <Slider x:Name="Speed" Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="OnEffectOptionChanged" />
                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                  Text="{Binding Value, ElementName=Speed}" />
                                </Grid>

                                <StackPanel x:Name="DirectionRow" Orientation="Horizontal">
                                    <ui:TextBlock Width="130" VerticalAlignment="Center" Text="{l:Tr Light_Direction}" />
                                    <RadioButton x:Name="DirectionNormal" GroupName="Dir" IsChecked="True" Margin="0,0,16,0"
                                                 Content="{l:Tr Light_DirectionNormal}" Checked="OnEffectOptionChanged" />
                                    <RadioButton x:Name="DirectionReverse" GroupName="Dir"
                                                 Content="{l:Tr Light_DirectionReverse}" Checked="OnEffectOptionChanged" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                        <ui:TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{l:Tr Light_AppliesLive}" />
                    </StackPanel>
                </TabItem>

                <!-- Per key -->
                <TabItem Header="{l:Tr Light_TabPerKey}">
                    <StackPanel Margin="0,16,0,0">
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr PerKey_Hint}" Margin="0,0,0,8" />
                        <c:KeyboardView x:Name="Board" MaxHeight="300" HorizontalAlignment="Left" />

                        <ui:Card Margin="0,12,0,0" Padding="20,16">
                            <StackPanel>
                                <c:ColorSwatches x:Name="KeyColor" />
                                <WrapPanel Margin="0,4,0,0">
                                    <ui:Button Appearance="Secondary" Content="{l:Tr PerKey_Paint}" Click="OnPaint" Margin="0,0,8,8">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="PaintBrush24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="{l:Tr PerKey_Erase}" Click="OnErase" Margin="0,0,8,8">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Eraser24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="{l:Tr PerKey_SelectAll}" Click="OnSelectAll" Margin="0,0,8,8" />
                                    <ui:Button Content="{l:Tr PerKey_ClearSelection}" Click="OnClearSelection" Margin="0,0,16,8" />
                                    <ui:TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="0,0,0,8"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <ui:TextBlock VerticalAlignment="Center" Margin="0,0,12,8" Text="{l:Tr PerKey_Presets}" />
                                    <ui:Button Content="{l:Tr PerKey_PresetGaming}" Click="OnPresetGaming" Margin="0,0,8,8" />
                                    <ui:Button Content="{l:Tr PerKey_PresetRows}" Click="OnPresetRows" Margin="0,0,8,8" />
                                    <ui:Button Content="{l:Tr PerKey_PresetClear}" Click="OnPresetClear" Margin="0,0,8,8" />
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Light_Brightness}" />
                                    <Slider x:Name="KeyBrightness" Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight" />
                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                  Text="{Binding Value, ElementName=KeyBrightness}" />
                                    <ui:Button x:Name="ApplyKeys" Grid.Column="4" Appearance="Primary" Content="{l:Tr PerKey_Apply}" Click="OnApplyKeys">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <ui:TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr PerKey_Note}" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </TabItem>

                <!-- Sides and light bar -->
                <TabItem Header="{l:Tr Light_TabZones}">
                    <StackPanel Margin="0,16,0,0" MaxWidth="760" HorizontalAlignment="Left">
                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{l:Tr Zones_Intro}" Margin="0,0,0,16" />
                        <ui:Card Padding="20,16" Margin="0,0,0,12">
                            <StackPanel x:Name="SidesGuide">
                                <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Zones_Sides}" Margin="0,0,0,12" />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Padding="20,16">
                            <StackPanel x:Name="BarGuide">
                                <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Zones_Bar}" Margin="0,0,0,12" />
                            </StackPanel>
                        </ui:Card>
                        <ui:TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{l:Tr Zones_Source}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
