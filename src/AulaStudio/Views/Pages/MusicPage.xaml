<Page x:Class="AulaStudio.Views.Pages.MusicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:AulaStudio.Localization"
      xmlns:c="clr-namespace:AulaStudio.Controls"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Music_Title}" Margin="0,0,0,4" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Music_Hint}" Margin="0,0,0,16" TextWrapping="Wrap" />

            <DockPanel Margin="0,0,0,12">
                <ui:Button x:Name="StartButton" DockPanel.Dock="Left" Appearance="Primary" Padding="20,10" Click="OnStartStop">
                    <ui:Button.Icon><ui:SymbolIcon x:Name="StartIcon" Symbol="Play24" /></ui:Button.Icon>
                </ui:Button>
                <ui:TextBlock x:Name="State" Margin="16,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <c:KeyboardView x:Name="Preview" MaxHeight="260" HorizontalAlignment="Left" IsHitTestVisible="False" />

            <ui:Card Margin="0,12,0,0" Padding="20,16">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Music_Effect}" Margin="0,0,0,8" />
                    <ListBox x:Name="Effects" SelectionChanged="OnSettingChanged" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="150" Margin="4,8">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="26" HorizontalAlignment="Center" />
                                    <ui:TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:TextBlock Width="130" VerticalAlignment="Center" Text="{l:Tr Music_Colors}" />
                        <RadioButton x:Name="ColorHeat" GroupName="MusicColor" Margin="0,0,16,0" Content="{l:Tr Music_ColorHeat}" Checked="OnSettingChanged" />
                        <RadioButton x:Name="ColorRainbow" GroupName="MusicColor" Margin="0,0,16,0" Content="{l:Tr Music_ColorRainbow}" Checked="OnSettingChanged" />
                        <RadioButton x:Name="ColorSingle" GroupName="MusicColor" Content="{l:Tr Music_ColorSingle}" Checked="OnSettingChanged" />
                    </StackPanel>
                    <c:ColorSwatches x:Name="SingleColor" Margin="130,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="{l:Tr Music_Sensitivity}" />
                        <Slider x:Name="Sensitivity" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="OnSettingChanged" />
                        <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                      Text="{Binding Value, ElementName=Sensitivity}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
            <ui:TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Music_Note}" />
        </StackPanel>
    </ScrollViewer>
</Page>
