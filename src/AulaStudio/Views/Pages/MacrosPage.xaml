<Page x:Class="AulaStudio.Views.Pages.MacrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:AulaStudio.Localization"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Macros_Title}" Margin="0,0,0,4" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Macros_Hint}" Margin="0,0,0,16" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Macro list -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Secondary" Content="{l:Tr Macros_New}" Click="OnNew" Margin="0,0,8,0">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="DeleteMacro" Content="{l:Tr Macros_Delete}" Click="OnDelete">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <ListBox x:Name="List" SelectionChanged="OnMacroSelected" />
            </DockPanel>

            <!-- Editor -->
            <ui:Card Grid.Column="2" Padding="20,16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <ui:TextBlock x:Name="Empty" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Macros_Empty}" TextWrapping="Wrap" />
                    <DockPanel x:Name="Editor" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:TextBlock Width="80" VerticalAlignment="Center" Text="{l:Tr Macros_Name}" />
                                <ui:TextBox x:Name="NameBox" Width="260" TextChanged="OnNameChanged" />
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <ui:Button x:Name="RecordButton" Appearance="Primary" Click="OnRecord" Margin="0,0,8,8">
                                    <ui:Button.Icon><ui:SymbolIcon x:Name="RecordIcon" Symbol="Record24" /></ui:Button.Icon>
                                </ui:Button>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="RecordDelays" IsChecked="True" Content="{l:Tr Macros_RecordDelays}" Margin="0,0,16,8" VerticalAlignment="Center" />
                                <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,8" Text="{l:Tr Macros_DefaultDelay}" />
                                <ui:NumberBox x:Name="DefaultDelay" Width="130" Minimum="10" Maximum="65535" Value="30" MaxDecimalPlaces="0" Margin="0,0,0,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,8" Text="{l:Tr Macros_AddClick}" />
                                <ui:Button Content="{l:Tr Mouse_Left}" Tag="Left" Click="OnAddClick" Margin="0,0,6,8" />
                                <ui:Button Content="{l:Tr Mouse_Right}" Tag="Right" Click="OnAddClick" Margin="0,0,6,8" />
                                <ui:Button Content="{l:Tr Mouse_Middle}" Tag="Middle" Click="OnAddClick" Margin="0,0,16,8" />
                                <ui:Button Content="{l:Tr Macros_RemoveStep}" Click="OnRemoveStep" Margin="0,0,6,8">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{l:Tr Macros_Clear}" Click="OnClear" Margin="0,0,6,8" />
                            </WrapPanel>
                            <ui:InfoBar x:Name="Recording" IsOpen="False" IsClosable="False" Severity="Warning" Message="{l:Tr Macros_Recording}" Margin="0,0,0,8" />
                        </StackPanel>
                        <ui:TextBlock DockPanel.Dock="Bottom" x:Name="Memory" Margin="0,8,0,0" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ListBox x:Name="Steps" MinHeight="160" MaxHeight="300" SelectionMode="Extended" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Timer24" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ui:NumberBox Width="130" Minimum="10" Maximum="65535" MaxDecimalPlaces="0"
                                                          Value="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <ui:TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <ui:Button x:Name="SendButton" DockPanel.Dock="Right" Appearance="Primary" Content="{l:Tr Macros_Send}" Click="OnSend">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Send24" /></ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,16,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Macros_Note}" />
        </DockPanel>
    </Grid>
</Page>
