<Page x:Class="AulaStudio.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:AulaStudio.Localization"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <ui:TextBlock FontTypography="Title" Text="{l:Tr Nav_Settings}" Margin="0,0,0,24" />

            <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Settings_KeyboardSection}" Margin="0,0,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Device_Sleep}" />
                        <ui:TextBlock x:Name="Device_SleepDesc" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Device_SleepDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="SleepBox" MinWidth="180" SelectionChanged="OnDeviceChanged" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Device_Response}" />
                        <ui:TextBlock x:Name="Device_ResponseDesc" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Device_ResponseDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="ResponseSlider" Width="180" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" ValueChanged="OnDeviceChanged" VerticalAlignment="Center" />
                    <ui:TextBlock Width="24" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=ResponseSlider}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Device_Fn}" />
                        <ui:TextBlock x:Name="Device_FnDesc" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Device_FnDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="FnBox" MinWidth="180" SelectionChanged="OnDeviceChanged" />
            </ui:CardControl>
            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True">
                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Games24" /></ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Device_Game}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Device_GameDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <CheckBox x:Name="NoWin" Content="{l:Tr Device_NoWin}" Click="OnDeviceChanged" Margin="0,0,0,8" />
                    <CheckBox x:Name="NoAltF4" Content="{l:Tr Device_NoAltF4}" Click="OnDeviceChanged" Margin="0,0,0,8" />
                    <CheckBox x:Name="NoAltTab" Content="{l:Tr Device_NoAltTab}" Click="OnDeviceChanged" />
                </StackPanel>
            </ui:CardExpander>
            <ui:TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Device_AppliesLive}" Margin="0,0,0,24" />

            <ui:TextBlock FontTypography="Subtitle" Text="{l:Tr Settings_AppSection}" Margin="0,0,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="LocalLanguage24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_Language}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Settings_LanguageDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageBox" MinWidth="180" SelectionChanged="OnLanguageChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Clock24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_AutoClock}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Settings_AutoClockDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:Tr Settings_SyncNow}" Margin="0,0,16,0" Click="OnSyncNow" />
                    <ui:ToggleSwitch x:Name="AutoClockSwitch" Click="OnAutoClockChanged" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowMinimize24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_MinimizeToTray}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Settings_MinimizeToTrayDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TraySwitch" Click="OnTrayChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,24">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="DarkTheme24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_Theme}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr Settings_ThemeDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:TextBlock FontTypography="BodyStrong" Text="{l:Tr Settings_About}" Margin="0,0,0,6" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{l:Tr Settings_AboutBody}" />
        </StackPanel>
    </ScrollViewer>
</Page>
