<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aula.Protocol\Aula.Protocol.csproj" />
    <ProjectReference Include="..\Aula.Media\Aula.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\f108pro-layout.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Only the app's own languages; drops the runtime's other translations from the install. -->
    <SatelliteResourceLanguages>pt;en</SatelliteResourceLanguages>
    <AssemblyName>AulaStudio</AssemblyName>
    <Product>AULA Studio</Product>
    <Version>1.1.0</Version>
    <Description>Configuração do teclado AULA F108 Pro</Description>
  </PropertyGroup>

</Project>
